# ── Google Cloud Platform Configuration ──────────────────────────────────────
# Used by wakellm.sh for GCP Cloud Run Job management

PROJECT=your-gcp-project-id
REGION=europe-west1
SERVICE_ACCOUNT=wakellm-security-runner@your-gcp-project-id.iam.gserviceaccount.com
PROD_JOB_NAME=wakellm-security
DEV_JOB_NAME=wakellm-security-dev
REPO=wakellm-security
IMAGE_NAME=wakellm-security

# ── Application Runtime Configuration ────────────────────────────────────────

NODE_ENV=development

# Gemini AI API key
# LOCAL: Can be set here for local development
# PRODUCTION: Must be stored in GCP Secret Manager as 'gemini-api-key' secret
# SECURITY: Never commit a real key. Rotate immediately if accidentally committed.
GEMINI_API_KEY=

# GitHub token for advisory ingestion (api.github.com/advisories)
# PRODUCTION: Must be stored in GCP Secret Manager as 'github-token' secret
GITHUB_TOKEN=

# Path to the YAML/JSON sources config file (default: config/sources.yaml)
# The file is baked into the Docker image; override for custom feed lists.
SOURCES_CONFIG=config/sources.yaml

# Comma or newline-separated list of monitored packages (optional)
# Threats matching these packages are auto-escalated to CRITICAL + TOP_PRIORITY
# PRODUCTION: Store in GCP Secret Manager as 'SECURITY_MONITORED_PACKAGES' secret
SECURITY_MONITORED_PACKAGES=

# Optional context string injected at the top of every LLM prompt
LLM_GLOBAL_CONTEXT=

# Gemini model to use (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
